# Contact form email delivery (Resend — https://resend.com). Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Copy this file to .env.local for local development.

# API key from the Resend dashboard (starts with re_)
RESEND_API_KEY=

# Where contact messages are delivered
CONTACT_TO_EMAIL=shahzaibmughal1048@gmail.com

# Sender address. Until you verify your own domain in Resend, use: Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
